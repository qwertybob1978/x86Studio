<Window x:Class="ClassicMacIde.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="ClassicMacStudio 0.1"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <DrawingBrush x:Key="ClassicTitleBarPattern"
                      TileMode="Tile"
                      Viewport="0,0,1,2"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,1,2"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White"
                                     Geometry="M 0,0 L 1,0 L 1,2 L 0,2 Z" />
                    <GeometryDrawing Brush="Black"
                                     Geometry="M 0,0 L 1,0 L 1,1 L 0,1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="RibbonGroupStyle" TargetType="Border">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Background" Value="#FAFBFD" />
            <Setter Property="BorderBrush" Value="#D2D8E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style x:Key="RibbonCommandButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E8EFF8" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#9FB4D0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D5E2F2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New Project..."
                          Click="NewProject_Click" />
                <MenuItem Header="Open Project..."
                          Click="OpenProject_Click" />
                <Separator />
                <MenuItem x:Name="SaveProjectMenuItem"
                          Header="Save Project"
                          IsEnabled="False"
                          Click="SaveProject_Click" />
                <MenuItem Header="Save Project As..."
                          Click="SaveProjectAs_Click" />
                <Separator />
                <MenuItem x:Name="SaveCodeFileMenuItem"
                          Header="Save File"
                          IsEnabled="False"
                          Click="SaveCodeFile_Click" />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem x:Name="MiniVmacMenuItem"
                          Header="Mini vMac (Mac SE)"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="MiniVmacMenuItem_Click" />
                <MenuItem x:Name="BasiliskIIMenuItem"
                          Header="Basilisk II (Color Classic / PowerBook)"
                          IsCheckable="True"
                          Click="BasiliskIIMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Window">
                <MenuItem x:Name="ToolboxPaneMenuItem"
                          Header="_Toolbox / Project Explorer"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="ToolboxPaneMenuItem_Click" />
                <MenuItem x:Name="InspectorPaneMenuItem"
                          Header="_Properties / Events"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="InspectorPaneMenuItem_Click" />
                <MenuItem x:Name="BuildOutputMenuItem"
                          Header="_Build Output"
                          IsCheckable="True"
                          IsChecked="False"
                          Click="BuildOutputMenuItem_Click" />
                <MenuItem x:Name="SerialTerminalWindowMenuItem"
                          Header="_Serial Terminal"
                          IsCheckable="True"
                          IsChecked="False"
                          Click="SerialTerminalWindowMenuItem_Click" />
                <MenuItem x:Name="SerialAgentConnectionWindowMenuItem"
                          Header="Serial _Agent Connection"
                          IsCheckable="True"
                          IsChecked="False"
                          Click="SerialAgentConnectionWindowMenuItem_Click" />
                <Separator />
                <MenuItem Header="_Restore Default Layout"
                          Click="RestoreDefaultLayout_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="IDE Help"
                          Click="OpenHelp_Click" />
                <Separator />
                <MenuItem Header="About" Click="About_Click" />
            </MenuItem>
        </Menu>
        <TabControl DockPanel.Dock="Top"
                    Height="128"
                    Background="#F2F4F7"
                    BorderBrush="#C8D0DB"
                    BorderThickness="0,0,0,1">
            <TabItem Header="Home">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <ComboBox x:Name="TargetProfileSelector"
                                      Width="245"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="TargetProfileSelector_SelectionChanged" />
                            <TextBlock Text="Target profile"
                                       HorizontalAlignment="Center"
                                       Foreground="#555555"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <ComboBox x:Name="DesignerToolSelector"
                                      Width="155"
                                      SelectedIndex="0"
                                      SelectionChanged="DesignerToolSelector_SelectionChanged">
                                <ComboBoxItem Content="Select / Move" />
                                <ComboBoxItem Content="Place Widget" />
                                <ComboBoxItem Content="Resize / Anchors" />
                            </ComboBox>
                            <TextBlock Text="Designer tool"
                                       HorizontalAlignment="Center"
                                       Foreground="#555555"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0"
                                    Style="{StaticResource RibbonCommandButtonStyle}"
                                    ToolTip="Add the selected control or graphic to the form"
                                    AutomationProperties.Name="Add widget"
                                    Click="PlaceWidget_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Viewbox Width="24" Height="24">
                                        <Path Fill="#526579"
                                              Data="M11,13.5V21.5H3V13.5H11M12,2L17.5,11H6.5L12,2M17.5,13C20,13 22,15 22,17.5C22,20 20,22 17.5,22C15,22 13,20 13,17.5C13,15 15,13 17.5,13Z" />
                                    </Viewbox>
                                    <TextBlock Text="Add Widget" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Row="1"
                                       Text="Designer"
                                       HorizontalAlignment="Center"
                                       Foreground="#555555"
                                       FontSize="11" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button x:Name="BuildRunButton"
                                    Style="{StaticResource RibbonCommandButtonStyle}"
                                    ToolTip="Build the current form and launch it in the selected emulator"
                                    AutomationProperties.Name="Build and run"
                                    Click="BuildRunButton_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Viewbox Width="25" Height="25">
                                        <Path Fill="#2E7D32"
                                              Data="M8,5.14V19.14L19,12.14L8,5.14Z" />
                                    </Viewbox>
                                    <TextBlock Text="Build &amp; Run" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BuildTestButton"
                                    Style="{StaticResource RibbonCommandButtonStyle}"
                                    ToolTip="Build and run the automated guest test"
                                    AutomationProperties.Name="Build and test"
                                    Click="BuildTestButton_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Viewbox Width="25" Height="25">
                                        <Path Fill="#315E8A"
                                              Data="M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3Z" />
                                    </Viewbox>
                                    <TextBlock Text="Build &amp; Test" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopEmulatorButton"
                                    Style="{StaticResource RibbonCommandButtonStyle}"
                                    ToolTip="Stop the IDE-managed emulator process"
                                    AutomationProperties.Name="Stop emulator"
                                    IsEnabled="False"
                                    Click="StopEmulatorButton_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Viewbox Width="25" Height="25">
                                        <Path Fill="#B3261E"
                                              Data="M18,18H6V6H18V18Z" />
                                    </Viewbox>
                                    <TextBlock Text="Stop Emulator" FontSize="11" />
                                </StackPanel>
                            </Button>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Text="Build &amp; Run"
                                       HorizontalAlignment="Center"
                                       Foreground="#555555"
                                       FontSize="11" />
                        </Grid>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Components">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel>
                            <ComboBox x:Name="RibbonComponentPalette"
                                      Width="205"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="RibbonComponentPalette_SelectionChanged" />
                            <TextBlock Text="Nonvisual component"
                                       HorizontalAlignment="Center"
                                       Foreground="#555555"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonCommandButtonStyle}"
                                    ToolTip="Add the selected nonvisual component to the tray"
                                    AutomationProperties.Name="Add component"
                                    Click="AddNonVisualComponent_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <Viewbox Width="25" Height="25">
                                        <Path Fill="#526579"
                                              Data="M20.5,11H19V7C19,5.89 18.1,5 17,5H13V3.5A2.5,2.5 0 0,0 10.5,1A2.5,2.5 0 0,0 8,3.5V5H4A2,2 0 0,0 2,7V10.8H3.5C5,10.8 6.2,12 6.2,13.5C6.2,15 5,16.2 3.5,16.2H2V20A2,2 0 0,0 4,22H7.8V20.5C7.8,19 9,17.8 10.5,17.8C12,17.8 13.2,19 13.2,20.5V22H17A2,2 0 0,0 19,20V16H20.5A2.5,2.5 0 0,0 23,13.5A2.5,2.5 0 0,0 20.5,11Z" />
                                    </Viewbox>
                                    <TextBlock Text="Add Component" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonCommandButtonStyle}"
                                    ToolTip="Remove the selected component from the tray"
                                    AutomationProperties.Name="Remove component"
                                    Click="RemoveNonVisualComponent_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="-"
                                               FontSize="24"
                                               Height="27"
                                               Foreground="#B3261E"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Remove" FontSize="11" />
                                </StackPanel>
                            </Button>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Text="Component tray"
                                       HorizontalAlignment="Center"
                                       Foreground="#555555"
                                       FontSize="11" />
                        </Grid>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Design">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <CheckBox x:Name="SnapToGridToggle"
                                      Content="Snap to grid"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      Margin="4"
                                      Checked="GridSettings_Changed"
                                      Unchecked="GridSettings_Changed" />
                            <StackPanel>
                                <ComboBox x:Name="GridSpacingSelector"
                                          Width="68"
                                          IsEditable="True"
                                          Text="8"
                                          SelectionChanged="GridSettings_Changed"
                                          LostFocus="GridSpacing_LostFocus">
                                    <ComboBoxItem Content="4" />
                                    <ComboBoxItem Content="8" />
                                    <ComboBoxItem Content="12" />
                                    <ComboBoxItem Content="16" />
                                    <ComboBoxItem Content="24" />
                                </ComboBox>
                                <TextBlock Text="Grid size"
                                           HorizontalAlignment="Center"
                                           Foreground="#555555"
                                           FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Text="Grid"
                                       HorizontalAlignment="Center"
                                       Foreground="#555555"
                                       FontSize="11" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button x:Name="AlignLeftButton"
                                    Style="{StaticResource RibbonCommandButtonStyle}"
                                    Content="Left"
                                    ToolTip="Align left edges"
                                    Tag="Left"
                                    Click="AlignControls_Click" />
                            <Button x:Name="AlignRightButton"
                                    Style="{StaticResource RibbonCommandButtonStyle}"
                                    Content="Right"
                                    ToolTip="Align right edges"
                                    Tag="Right"
                                    Click="AlignControls_Click" />
                            <Button x:Name="AlignTopButton"
                                    Style="{StaticResource RibbonCommandButtonStyle}"
                                    Content="Top"
                                    ToolTip="Align top edges"
                                    Tag="Top"
                                    Click="AlignControls_Click" />
                            <Button x:Name="AlignBottomButton"
                                    Style="{StaticResource RibbonCommandButtonStyle}"
                                    Content="Bottom"
                                    ToolTip="Align bottom edges"
                                    Tag="Bottom"
                                    Click="AlignControls_Click" />
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Text="Alignment"
                                       HorizontalAlignment="Center"
                                       Foreground="#555555"
                                       FontSize="11" />
                        </Grid>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBox x:Name="BuildOutput"
                 DockPanel.Dock="Bottom"
                 Height="110"
                 Margin="0,1,0,0"
                 Padding="8"
                 FontFamily="Consolas"
                 FontSize="12"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Visibility="Collapsed" />
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" />
        </StatusBar>
        <Grid x:Name="EditorLayoutGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ToolboxColumn" Width="205" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="240" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ToolboxPane"
                    Grid.Column="0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="0,0,1,0"
                    Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Target profile"
                                   FontWeight="SemiBold"
                                   FontSize="15" />
                        <TextBlock x:Name="ProfileNameText"
                                   Margin="0,8,0,2"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ResolutionText"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ModeText"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="VerificationText"
                                   Margin="0,8,0,0"
                                   Foreground="#555555"
                                   TextWrapping="Wrap" />
                        <Separator Margin="0,12,0,10" />
                    </StackPanel>
                    <TabControl x:Name="PaletteTabs"
                                Margin="0,2,0,0"
                                SelectionChanged="PaletteTabs_SelectionChanged">
                        <TabItem Header="Widgets">
                            <StackPanel Margin="4">
                                <TextBlock Text="System 7 controls"
                                           FontWeight="SemiBold" />
                                <ListBox x:Name="WidgetPalette"
                                         Margin="0,6,0,6"
                                         MaxHeight="270"
                                         DisplayMemberPath="DisplayName"
                                         SelectionChanged="WidgetPalette_SelectionChanged" />
                                <Button Content="Place on form"
                                        Padding="6,4"
                                        Click="PlaceWidget_Click" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="#555555"
                                           Text="Use Place Widget to add controls. Ctrl-click to multi-select; choose Resize to drag a control's size."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Graphics">
                            <StackPanel Margin="4">
                                <TextBlock Text="QuickDraw primitives"
                                           FontWeight="SemiBold" />
                                <ListBox x:Name="GraphicsPalette"
                                         Margin="0,6,0,6"
                                         MaxHeight="300"
                                         DisplayMemberPath="DisplayName"
                                         SelectionChanged="WidgetPalette_SelectionChanged" />
                                <Button Content="Place on form"
                                        Padding="6,4"
                                        Click="PlaceWidget_Click" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="#555555"
                                           Text="Filled shapes use classic black fill; dither uses the QuickDraw gray pattern. Resize circles to draw ovals."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Components">
                            <StackPanel Margin="4">
                                <TextBlock Text="Nonvisual components"
                                           FontWeight="SemiBold" />
                                <ListBox x:Name="NonVisualComponentPalette"
                                         Margin="0,6,0,6"
                                         MaxHeight="150"
                                         DisplayMemberPath="DisplayName"
                                         SelectionChanged="NonVisualComponentPalette_SelectionChanged" />
                                <Button Content="Add to form"
                                        Padding="6,4"
                                        Click="AddNonVisualComponent_Click" />
                                <TextBlock Text="Component tray"
                                           Margin="0,12,0,4"
                                           FontWeight="SemiBold" />
                                <ListBox x:Name="NonVisualComponentTray"
                                         MaxHeight="230"
                                         SelectionChanged="NonVisualComponentTray_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Id}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ComponentTypeId}"
                                                           Foreground="#555555"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="Remove selected component"
                                        Margin="0,6,0,0"
                                        Padding="6,4"
                                        Click="RemoveNonVisualComponent_Click" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="#555555"
                                           Text="Select a tray item to edit its properties and event handlers. Serial I/O requires real serial hardware; Mini vMac has no serial passthrough."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Project">
                            <DockPanel>
                                <TextBlock x:Name="ProjectNameText"
                                           DockPanel.Dock="Top"
                                           Margin="4"
                                           Text="No project open"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TreeView x:Name="ProjectFilesTree"
                                          Margin="2"
                                          MouseDoubleClick="ProjectFilesTree_MouseDoubleClick" />
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
            <TabControl x:Name="WorkspaceTabs"
                        Grid.Column="1">
                <TabItem Header="Designer">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#303030">
                        <Viewbox Stretch="Uniform" Margin="24">
                            <Canvas x:Name="PreviewCanvas">
                        <Border x:Name="MenuBar"
                                Height="20"
                                Background="White"
                                BorderBrush="Black"
                                BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal"
                                        Margin="7,0"
                                        VerticalAlignment="Center">
                                <Canvas Width="12" Height="12">
                                    <Path Fill="Black"
                                          Data="M 5,3 C 2,1 0,4 1,7 C 2,10 4,11 6,10 C 8,11 10,8 10,5 C 10,3 8,2 6,3 Z" />
                                    <Path Fill="Black"
                                          Data="M 6,2 C 6,0 8,0 10,0 C 10,2 8,3 6,3 Z" />
                                </Canvas>
                                <StackPanel x:Name="DesignerMenuTitles"
                                            Orientation="Horizontal"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="File  Edit  View  Special"
                                               FontFamily="Chicago"
                                               FontSize="9"
                                               Foreground="Black" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="FormFrame"
                                Canvas.Left="24"
                                Canvas.Top="32"
                                Background="White"
                                BorderBrush="Black"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="FormTitleBarRow" Height="20" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="FormTitleBar"
                                        Grid.Row="0"
                                        Background="{StaticResource ClassicTitleBarPattern}"
                                        BorderBrush="Black"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Border Background="{StaticResource ClassicTitleBarPattern}" />
                                        <Border Background="White"
                                                Padding="6,0"
                                                HorizontalAlignment="Center">
                                            <TextBlock x:Name="FormTitle"
                                                       Text="Untitled Window"
                                                       FontFamily="Chicago"
                                                       FontSize="9"
                                                       Foreground="Black"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="FormCloseBox"
                                                Width="12"
                                                Height="12"
                                                Margin="6,0"
                                                HorizontalAlignment="Left"
                                                Background="White"
                                                BorderBrush="Black"
                                                BorderThickness="1"
                                                Visibility="Collapsed"
                                                IsHitTestVisible="False">
                                            <Border Margin="2"
                                                    BorderBrush="Black"
                                                    BorderThickness="1" />
                                        </Border>
                                        <Border x:Name="FormZoomBox"
                                                Width="12"
                                                Height="12"
                                                Margin="6,0"
                                                HorizontalAlignment="Right"
                                                Background="White"
                                                BorderBrush="Black"
                                                BorderThickness="1"
                                                Visibility="Collapsed"
                                                IsHitTestVisible="False">
                                            <Path Margin="2"
                                                  Stroke="Black"
                                                  StrokeThickness="1"
                                                  Data="M 0,7 L 7,0" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Canvas x:Name="FormCanvas"
                                        Grid.Row="1"
                                        MouseLeftButtonDown="FormCanvas_MouseLeftButtonDown" />
                                <Border x:Name="FormGrowBox"
                                        Grid.Row="1"
                                        Width="14"
                                        Height="14"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="White"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False">
                                    <Path Margin="2"
                                          Stroke="Black"
                                          StrokeThickness="1"
                                          Data="M 1,9 L 9,1 M 4,9 L 9,4 M 7,9 L 9,7" />
                                </Border>
                            </Grid>
                        </Border>
                            </Canvas>
                        </Viewbox>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Code">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="#F0F0F0"
                                BorderBrush="#CCCCCC"
                                BorderThickness="0,0,0,1"
                                Padding="6">
                            <TextBlock x:Name="ActiveCodeFileText"
                                       Text="Open a file from Project Explorer"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <avalon:TextEditor x:Name="CodeEditor"
                                           IsReadOnly="True"
                                           ShowLineNumbers="True"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           Padding="6"
                                           WordWrap="False" />
                    </DockPanel>
                </TabItem>
            </TabControl>
            <Border x:Name="InspectorPane"
                    Grid.Column="2"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1,0,0,0"
                    Padding="12">
                <TabControl x:Name="InspectorTabs">
                    <TabItem Header="Properties">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                                <TextBlock Text="Form title"
                                           Margin="0,8,0,3"
                                           FontWeight="SemiBold" />
                                <TextBox x:Name="FormTitleEditor"
                                         Text="Untitled Window"
                                         LostFocus="FormTitleEditor_LostFocus" />
                                <TextBlock Text="Form type (C identifier)"
                                           Margin="0,10,0,3"
                                           FontWeight="SemiBold" />
                                <TextBox x:Name="FormTypeNameEditor"
                                         Text="MainForm"
                                         ToolTip="C type name used for the main form handle"
                                         LostFocus="FormTypeNameEditor_LostFocus" />
                                <TextBlock Text="Selected object"
                                           Margin="0,14,0,4"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ControlIdText"
                                           Text="None"
                                           TextWrapping="Wrap" />
                                <StackPanel x:Name="FormPropertyEditors"
                                            Visibility="Collapsed"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="Window appearance"
                                               Margin="0,0,0,4"
                                               FontWeight="SemiBold" />
                                    <CheckBox x:Name="FormTitleBarEditor"
                                              Content="Show title bar"
                                              Tag="showTitleBar"
                                              Checked="FormBooleanProperty_Changed"
                                              Unchecked="FormBooleanProperty_Changed" />
                                    <CheckBox x:Name="FormResizableEditor"
                                              Content="Resizable (grow box)"
                                              Tag="resizable"
                                              Checked="FormBooleanProperty_Changed"
                                              Unchecked="FormBooleanProperty_Changed" />
                                    <CheckBox x:Name="FormCloseBoxEditor"
                                              Content="Show close box"
                                              Tag="hasCloseBox"
                                              Checked="FormBooleanProperty_Changed"
                                              Unchecked="FormBooleanProperty_Changed" />
                                    <CheckBox x:Name="FormZoomBoxEditor"
                                              Content="Show zoom box"
                                              Tag="hasZoomBox"
                                              Checked="FormBooleanProperty_Changed"
                                              Unchecked="FormBooleanProperty_Changed" />
                                    <CheckBox x:Name="FormMovableEditor"
                                              Content="Allow title-bar dragging"
                                              Tag="movable"
                                              Checked="FormBooleanProperty_Changed"
                                              Unchecked="FormBooleanProperty_Changed" />
                                    <CheckBox x:Name="FormVisibleEditor"
                                              Content="Visible at launch"
                                              Tag="visible"
                                              Checked="FormBooleanProperty_Changed"
                                              Unchecked="FormBooleanProperty_Changed" />
                                    <CheckBox x:Name="FormCenterOnScreenEditor"
                                              Content="Center on screen"
                                              Tag="centerOnScreen"
                                              Checked="FormBooleanProperty_Changed"
                                              Unchecked="FormBooleanProperty_Changed" />
                                    <TextBlock Text="Initial client size"
                                               Margin="0,8,0,3"
                                               FontWeight="SemiBold" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Width" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2"
                                                   Text="Height"
                                                   FontWeight="SemiBold" />
                                        <TextBox x:Name="FormWidthEditor"
                                                 Grid.Row="1"
                                                 Tag="width"
                                                 LostFocus="FormGeometryProperty_LostFocus" />
                                        <TextBox x:Name="FormHeightEditor"
                                                 Grid.Row="1"
                                                 Grid.Column="2"
                                                 Tag="height"
                                                 LostFocus="FormGeometryProperty_LostFocus" />
                                    </Grid>
                                    <TextBlock Text="Initial position (screen pixels)"
                                               Margin="0,8,0,3"
                                               FontWeight="SemiBold" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Left" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2"
                                                   Text="Top"
                                                   FontWeight="SemiBold" />
                                        <TextBox x:Name="FormLeftEditor"
                                                 Grid.Row="1"
                                                 Tag="left"
                                                 LostFocus="FormGeometryProperty_LostFocus" />
                                        <TextBox x:Name="FormTopEditor"
                                                 Grid.Row="1"
                                                 Grid.Column="2"
                                                 Tag="top"
                                                 LostFocus="FormGeometryProperty_LostFocus" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock x:Name="ControlTextLabel"
                                           Text="Text"
                                           Margin="0,10,0,3"
                                           FontWeight="SemiBold" />
                                <TextBox x:Name="ControlTextEditor"
                                         LostFocus="CommonProperty_LostFocus" />
                                <Grid x:Name="ControlGeometryEditors"
                                      Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="X"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2"
                                               Text="Y"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="ControlXEditor"
                                             Grid.Row="1"
                                             LostFocus="CommonProperty_LostFocus" />
                                    <TextBox x:Name="ControlYEditor"
                                             Grid.Row="1"
                                             Grid.Column="2"
                                             LostFocus="CommonProperty_LostFocus" />
                                    <TextBlock Grid.Row="2"
                                               Text="Width"
                                               Margin="0,6,0,0"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="2"
                                               Text="Height"
                                               Margin="0,6,0,0"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="ControlWidthEditor"
                                             Grid.Row="3"
                                             LostFocus="CommonProperty_LostFocus" />
                                    <TextBox x:Name="ControlHeightEditor"
                                             Grid.Row="3"
                                             Grid.Column="2"
                                             LostFocus="CommonProperty_LostFocus" />
                                </Grid>
                                <TextBlock x:Name="WidgetPropertiesLabel"
                                           Text="Widget properties"
                                           Margin="0,12,0,4"
                                           FontWeight="SemiBold" />
                                <StackPanel x:Name="WidgetPropertyEditors" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Events">
                        <StackPanel Margin="4">
                            <TextBlock x:Name="EventOwnerText"
                                       Text="Select a widget to inspect its events."
                                       Margin="0,8,0,4"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold" />
                            <ItemsControl x:Name="EventEditors"
                                          Margin="0,4" />
                            <TextBlock x:Name="EventHintText"
                                       Foreground="#555555"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
