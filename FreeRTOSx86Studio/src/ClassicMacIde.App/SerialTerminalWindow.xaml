<Window x:Class="ClassicMacIde.App.SerialTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial Terminal"
        Width="760"
        Height="560"
        MinWidth="620"
        MinHeight="420"
        Closing="SerialTerminalWindow_Closing">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Text="ASCII serial terminal for a Basilisk II guest. Connect Basilisk to one virtual COM endpoint and this terminal to its paired endpoint. A virtual null-modem driver must be installed and configured separately." />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,6,8,6"
                           VerticalAlignment="Center"
                           Text="IDE COM port:" />
                <ComboBox x:Name="TerminalComPortComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          Margin="0,3,12,3"
                          IsEditable="True" />
                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Margin="0,6,8,6"
                           VerticalAlignment="Center"
                           Text="Baud rate:" />
                <ComboBox x:Name="BaudRateComboBox"
                          Grid.Row="0"
                          Grid.Column="3"
                          Margin="0,3"
                          SelectedIndex="4">
                    <ComboBoxItem Content="300" />
                    <ComboBoxItem Content="1200" />
                    <ComboBoxItem Content="2400" />
                    <ComboBoxItem Content="4800" />
                    <ComboBoxItem Content="9600" />
                    <ComboBoxItem Content="19200" />
                    <ComboBoxItem Content="38400" />
                    <ComboBoxItem Content="57600" />
                </ComboBox>
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,6,8,6"
                           VerticalAlignment="Center"
                           Text="Basilisk COM port:" />
                <ComboBox x:Name="BasiliskComPortComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,3,12,3"
                          IsEditable="True" />
                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Margin="0,6,8,6"
                           VerticalAlignment="Center"
                           Text="Guest port:" />
                <ComboBox x:Name="BasiliskChannelComboBox"
                          Grid.Row="1"
                          Grid.Column="3"
                          Margin="0,3"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Serial A (Modem)" Tag="A" />
                    <ComboBoxItem Content="Serial B (Printer)" Tag="B" />
                </ComboBox>
            </Grid>
            <StackPanel Margin="0,0,0,8"
                        Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        Padding="10,5"
                        Click="ApplyBasiliskSettings_Click"
                        Content="Apply to Basilisk" />
                <Button x:Name="ConnectButton"
                        Margin="0,0,8,0"
                        Padding="10,5"
                        Click="ConnectButton_Click"
                        Content="Connect" />
                <Button x:Name="DisconnectButton"
                        Padding="10,5"
                        Click="DisconnectButton_Click"
                        Content="Disconnect"
                        IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       Margin="0,0,0,8"
                       Text="Not connected." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom"
                    Margin="0,8,0,0"
                    Orientation="Horizontal">
            <TextBox x:Name="SendTextBox"
                     MinWidth="300"
                     Margin="0,0,8,0"
                     Padding="5"
                     VerticalContentAlignment="Center"
                     KeyDown="SendTextBox_KeyDown" />
            <Button x:Name="SendButton"
                    Padding="14,5"
                    Click="SendButton_Click"
                    Content="Send"
                    IsEnabled="False" />
        </StackPanel>
        <TextBox x:Name="TerminalOutput"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 FontSize="13"
                 IsReadOnly="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" />
    </DockPanel>
</Window>
