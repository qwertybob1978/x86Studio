<Window x:Class="ClassicMacIde.App.FreeRTOSx86StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="FreeRTOSx86Studio"
        Width="1500"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <Window.Resources>
        <Style x:Key="RibbonCommandButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{DynamicResource MaterialDesign.Brush.Secondary.Light}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="10,4,14,2" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="CodeEditorStyle" TargetType="{x:Type avalon:TextEditor}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ShowLineNumbers" Value="True" />
            <Setter Property="WordWrap" Value="False" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <TabControl x:Name="RibbonTabs"
                    DockPanel.Dock="Top"
                    Height="146"
                    Background="{DynamicResource MaterialDesign.Brush.Surface}"
                    BorderThickness="0">
            <TabItem Header="Project">
                <Border Padding="10,4"
                        Background="{DynamicResource MaterialDesign.Brush.Surface}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonCommandButton}"
                                        Click="NewProject_Click"
                                        ToolTip="Create a new GUI project">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="FilePlusOutline"
                                                                 Width="26"
                                                                 Height="26"
                                                                 HorizontalAlignment="Center" />
                                        <TextBlock Text="New" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonCommandButton}"
                                        Click="OpenProject_Click"
                                        ToolTip="Open a GUI project">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="FolderOpen"
                                                                 Width="26"
                                                                 Height="26"
                                                                 HorizontalAlignment="Center" />
                                        <TextBlock Text="Open" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonCommandButton}"
                                        Click="SaveProject_Click"
                                        ToolTip="Save project and editable source">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="ContentSave"
                                                                 Width="26"
                                                                 Height="26"
                                                                 HorizontalAlignment="Center" />
                                        <TextBlock Text="Save" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonCommandButton}"
                                        Click="SaveProjectAs_Click"
                                        ToolTip="Save the project to a new file">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="ContentSaveEdit"
                                                                 Width="26"
                                                                 Height="26"
                                                                 HorizontalAlignment="Center" />
                                        <TextBlock Text="Save As" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RibbonGroup}">
                            <StackPanel Width="330">
                                <TextBlock Text="TARGET PROFILE"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,4"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                <ComboBox x:Name="TargetProfileSelector"
                                          Height="36"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="TargetProfileSelector_SelectionChanged" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BuildRunButton"
                                        Style="{StaticResource RibbonCommandButton}"
                                        Click="BuildRun_Click"
                                        ToolTip="Build and run in DOSBox-X">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="Play"
                                                                 Width="26"
                                                                 Height="26"
                                                                 HorizontalAlignment="Center" />
                                        <TextBlock Text="Build &amp; Run"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <CheckBox x:Name="EnableAgentDebugToggle"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          IsChecked="True"
                                          Content="Agent COM2"
                                          ToolTip="Connect the DOSBox guest COM1 to host COM2 for the DOS Agent." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RibbonGroup}">
                            <StackPanel>
                                <TextBlock Text="AGENT DEBUG"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,4"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RibbonCommandButton}"
                                            Click="OpenDosAgentDebug_Click"
                                            ToolTip="Open the DOSBox-X Agent connection on host COM4">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="CableData"
                                                                     Width="26"
                                                                     Height="26"
                                                                     HorizontalAlignment="Center" />
                                            <TextBlock Text="DOSBox COM4"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="LVGL">
                <TabControl x:Name="WidgetRibbonTabs"
                            Background="{DynamicResource MaterialDesign.Brush.Surface}"
                            BorderThickness="0">
                    <TabItem Header="Controls">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="ControlsRibbonPanel" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Data">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="DataRibbonPanel" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Containers">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="ContainersRibbonPanel" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Media">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="MediaRibbonPanel" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Drawing">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="DrawingRibbonPanel" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Design">
                        <Border Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource RibbonGroup}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,4">
                                            <CheckBox x:Name="ShowGridToggle"
                                                      Content="Show grid"
                                                      IsChecked="True"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      Checked="GridSettings_Changed"
                                                      Unchecked="GridSettings_Changed" />
                                            <CheckBox x:Name="SnapToGridToggle"
                                                      Content="Snap to grid"
                                                      IsChecked="True"
                                                      VerticalAlignment="Center"
                                                      Checked="GridSettings_Changed"
                                                      Unchecked="GridSettings_Changed" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Grid size"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <ComboBox x:Name="GridSpacingSelector"
                                                      Width="76"
                                                      Height="30"
                                                      IsEditable="True"
                                                      Text="8"
                                                      SelectionChanged="GridSettings_Changed"
                                                      LostFocus="GridSpacing_LostFocus">
                                                <ComboBoxItem Content="4" />
                                                <ComboBoxItem Content="8" />
                                                <ComboBoxItem Content="12" />
                                                <ComboBoxItem Content="16" />
                                                <ComboBoxItem Content="24" />
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RibbonGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource RibbonCommandButton}"
                                                Click="DeleteControl_Click"
                                                ToolTip="Delete the selected object">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="DeleteOutline"
                                                                         Width="26"
                                                                         Height="26"
                                                                         HorizontalAlignment="Center" />
                                                <TextBlock Text="Delete" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource RibbonCommandButton}"
                                                Click="ApplyProperties_Click"
                                                ToolTip="Apply the selected object's properties">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="Check"
                                                                         Width="26"
                                                                         Height="26"
                                                                         HorizontalAlignment="Center" />
                                                <TextBlock Text="Apply" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   Padding="12,7"
                   Background="{DynamicResource MaterialDesign.Brush.Surface}"
                   Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                   Text="Ready" />

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="0" Margin="4">
                <TextBlock DockPanel.Dock="Top"
                           Text="LVGL Toolbox"
                           FontWeight="SemiBold"
                           Margin="4,4,4,8" />
                <Button DockPanel.Dock="Bottom"
                        Margin="0,8,0,0"
                        Click="AddControl_Click"
                        ToolTip="Add the selected toolbox item to the designer">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" />
                        <TextBlock Text="Add selected" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <ListBox x:Name="WidgetPalette"
                         DisplayMemberPath="DisplayName"
                         SelectionMode="Single"
                         BorderThickness="0" />
            </DockPanel>

            <TabControl x:Name="WorkspaceTabs"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="6,0"
                        Background="{DynamicResource MaterialDesign.Brush.Surface}">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboardOutline"
                                                     Width="18"
                                                     Height="18"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="GUI Designer" />
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel Margin="10">
                        <TextBlock x:Name="DisplayInfoText"
                                   DockPanel.Dock="Top"
                                   Text="DOS display preview"
                                   FontWeight="SemiBold"
                                   Margin="2,2,2,8" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="{DynamicResource MaterialDesign.Brush.SurfaceVariant}">
                            <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Outline}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                <Canvas x:Name="DesignCanvas"
                                        Width="720"
                                        Height="348"
                                        Background="Black"
                                        ClipToBounds="True"
                                        SnapsToDevicePixels="True"
                                        RenderOptions.EdgeMode="Aliased" />
                            </Border>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CodeBraces"
                                                     Width="18"
                                                     Height="18"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="gui_task.c" />
                        </StackPanel>
                    </TabItem.Header>
                    <avalon:TextEditor x:Name="TaskCodeEditor"
                                       Style="{StaticResource CodeEditorStyle}"
                                       IsReadOnly="True" />
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CodeTags"
                                                     Width="18"
                                                     Height="18"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="user_events.c" />
                        </StackPanel>
                    </TabItem.Header>
                    <avalon:TextEditor x:Name="UserEventsCodeEditor"
                                       Style="{StaticResource CodeEditorStyle}" />
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CodeBracesBox"
                                                     Width="18"
                                                     Height="18"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="user_events.h" />
                        </StackPanel>
                    </TabItem.Header>
                    <avalon:TextEditor x:Name="UserEventsHeaderEditor"
                                       Style="{StaticResource CodeEditorStyle}"
                                       IsReadOnly="True" />
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Row="1"
                          Grid.ColumnSpan="3"
                          Height="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource MaterialDesign.Brush.Divider}" />

            <TabControl x:Name="BuildTabs"
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="4,2,4,0"
                        Background="{DynamicResource MaterialDesign.Brush.Surface}">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Console"
                                                     Width="18"
                                                     Height="18"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="Build Output" />
                        </StackPanel>
                    </TabItem.Header>
                    <avalon:TextEditor x:Name="BuildOutputEditor"
                                       Style="{StaticResource CodeEditorStyle}"
                                       IsReadOnly="True" />
                </TabItem>
            </TabControl>

            <ScrollViewer Grid.Row="0" Grid.Column="2" Margin="6,0,2,0">
                <StackPanel>
                    <TextBlock Text="Properties"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="4,4,4,12" />
                    <TextBlock Text="Control ID" />
                    <TextBox x:Name="ControlIdBox" IsReadOnly="True" Margin="0,3,0,10" />
                    <TextBlock Text="Text" />
                    <TextBox x:Name="TextBox" Margin="0,3,0,10" />
                    <StackPanel x:Name="WidgetPropertiesPanel" />
                    <TextBlock Text="X / Y" />
                    <Grid Margin="0,3,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="XBox" Margin="0,0,4,0" />
                        <TextBox x:Name="YBox" Grid.Column="1" Margin="4,0,0,0" />
                    </Grid>
                    <TextBlock Text="Width / Height" />
                    <Grid Margin="0,3,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WidthBox" Margin="0,0,4,0" />
                        <TextBox x:Name="HeightBox" Grid.Column="1" Margin="4,0,0,0" />
                    </Grid>
                    <TextBlock Text="OnClick handler" />
                    <TextBox x:Name="ClickHandlerBox" Margin="0,3,0,10" />
                    <Button Click="ApplyProperties_Click"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" />
                            <TextBlock Text="Apply properties" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="0,4,0,10" />
                    <TextBlock Text="Project"
                               FontWeight="SemiBold"
                               Margin="0,4,0,6" />
                    <TextBlock x:Name="ProjectPathText"
                               Text="Unsaved project"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
