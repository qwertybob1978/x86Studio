<Window x:Class="ClassicMacIde.App.SerialAgentConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial Agent Connection"
        Width="820"
        Height="490"
        MinWidth="740"
        MinHeight="410"
        Closing="SerialAgentConnectionWindow_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Text="Connect to a Studio Agent over a direct serial link or a paired virtual COM port. Available actions depend on the target's advertised capabilities." />
        <Grid Grid.Row="1"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="65" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="0,6,8,6"
                       VerticalAlignment="Center"
                       Text="PC COM port:" />
            <ComboBox x:Name="ComPortComboBox"
                      Grid.Column="1"
                      Margin="0,3,8,3" />
            <TextBlock Grid.Column="2"
                       Margin="0,6,8,6"
                       VerticalAlignment="Center"
                       Text="Baud:" />
            <ComboBox x:Name="BaudRateComboBox"
                      Grid.Column="3"
                      Margin="0,3,8,3"
                      SelectedIndex="8">
                <ComboBoxItem Content="300" />
                <ComboBoxItem Content="600" />
                <ComboBoxItem Content="1200" />
                <ComboBoxItem Content="1800" />
                <ComboBoxItem Content="2400" />
                <ComboBoxItem Content="3600" />
                <ComboBoxItem Content="4800" />
                <ComboBoxItem Content="7200" />
                <ComboBoxItem Content="9600" />
                <ComboBoxItem Content="14400" />
                <ComboBoxItem Content="19200" />
                <ComboBoxItem Content="28800" />
                <ComboBoxItem Content="38400" />
                <ComboBoxItem Content="57600" />
            </ComboBox>
            <Button x:Name="RefreshPortsButton"
                    Grid.Column="4"
                    Padding="10,5"
                    Click="RefreshPortsButton_Click"
                    Content="Refresh" />
        </Grid>
        <Grid Grid.Row="2"
                    Margin="0,0,0,12"
                    >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="DestinationNameLabel"
                       Margin="0,6,8,6"
                       VerticalAlignment="Center"
                       Text="Target app name:" />
            <TextBox x:Name="DestinationNameTextBox"
                     Grid.Column="1"
                     Margin="0,3"
                     Text="Application" />
        </Grid>
        <StackPanel Grid.Row="3"
                    Margin="0,0,0,12"
                    Orientation="Horizontal">
            <Button x:Name="ConnectButton"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Click="ConnectButton_Click"
                    Content="Connect" />
            <Button x:Name="DisconnectButton"
                    Padding="12,6"
                    Click="DisconnectButton_Click"
                    Content="Disconnect"
                    IsEnabled="False" />
            <Button x:Name="SendPackageButton"
                    Margin="8,0,8,0"
                    Padding="12,6"
                    Click="SendPackageButton_Click"
                    Content="Send Package..."
                    IsEnabled="False" />
            <Button x:Name="CancelTransferButton"
                    Padding="12,6"
                    Click="CancelTransferButton_Click"
                    Content="Cancel Transfer"
                    IsEnabled="False" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Margin="0,0,0,12"
                    Orientation="Horizontal">
            <Button x:Name="RunButton"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Click="RunButton_Click"
                    Content="Run Installed App"
                    IsEnabled="False" />
            <Button x:Name="StopButton"
                    Padding="12,6"
                    Click="StopButton_Click"
                    Content="Stop App"
                    IsEnabled="False" />
        </StackPanel>
        <GroupBox Grid.Row="5"
                  Header="Connection">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Row="0"
                           Margin="0,0,0,10"
                           FontWeight="SemiBold"
                           Text="Disconnected." />
                <TextBlock x:Name="AgentDetailsText"
                           Grid.Row="1"
                           Margin="0,0,0,8"
                           Text="No Agent information received."
                           TextWrapping="Wrap" />
                <TextBox x:Name="DebugLogTextBox"
                         Grid.Row="2"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled" />
            </Grid>
        </GroupBox>
        <TextBlock Grid.Row="6"
                   Margin="0,12,0,0"
                   Foreground="DimGray"
                   TextWrapping="Wrap"
                   Text="Package and file-transfer formats are target-specific. DOS uploads use an 8.3 name in the current DOS directory and do not launch the file. Debug records are acknowledged automatically." />
    </Grid>
</Window>
