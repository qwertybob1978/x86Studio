{
  "schemaVersion": 1,
  "name": "SerialTerminal",
  "targetProfileId": "mac-color-classic-68k",
  "formTitle": "Serial Terminal Demo",
  "formTypeName": "TerminalForm",
  "formProperties": {
    "showTitleBar": true,
    "resizable": false,
    "hasCloseBox": false,
    "hasZoomBox": false,
    "visible": true,
    "centerOnScreen": true,
    "movable": false,
    "left": 24,
    "top": 32,
    "width": null,
    "height": null
  },
  "controls": [
    {
      "id": "Instructions",
      "widgetTypeId": "static-text",
      "text": "Type a line and press Send. Incoming text appears below.",
      "x": 12,
      "y": 12,
      "width": 438,
      "height": 16,
      "properties": {},
      "events": {}
    },
    {
      "id": "ReceivedText",
      "widgetTypeId": "editable-text",
      "text": "",
      "x": 16,
      "y": 40,
      "width": 438,
      "height": 140,
      "properties": {},
      "events": {}
    },
    {
      "id": "InputLabel",
      "widgetTypeId": "static-text",
      "text": "Transmit:",
      "x": 12,
      "y": 188,
      "width": 58,
      "height": 16,
      "properties": {},
      "events": {}
    },
    {
      "id": "SendText",
      "widgetTypeId": "editable-text",
      "text": "",
      "x": 76,
      "y": 184,
      "width": 220,
      "height": 20,
      "properties": {},
      "events": {}
    },
    {
      "id": "SendButton",
      "widgetTypeId": "button",
      "text": "Send",
      "x": 312,
      "y": 184,
      "width": 68,
      "height": 24,
      "properties": {},
      "events": {
        "OnClick": "TerminalSendClick"
      }
    },
    {
      "id": "ClearButton",
      "widgetTypeId": "button",
      "text": "Clear",
      "x": 386,
      "y": 182,
      "width": 64,
      "height": 24,
      "properties": {},
      "events": {
        "OnClick": "TerminalClearClick"
      }
    },
    {
      "id": "ConnectionStatus",
      "widgetTypeId": "static-text",
      "text": "Opening serial port...",
      "x": 16,
      "y": 224,
      "width": 438,
      "height": 20,
      "properties": {},
      "events": {}
    }
  ],
  "components": [
    {
      "id": "SerialPort1",
      "componentTypeId": "serial-port",
      "properties": {
        "port": "Modem",
        "baud": "9600",
        "dataBits": "8",
        "parity": "None",
        "stopBits": "1",
        "flowControl": "None"
      },
      "events": {
        "OnDataAvailable": "SerialDataAvailable",
        "OnError": "SerialError"
      }
    }
  ]
}